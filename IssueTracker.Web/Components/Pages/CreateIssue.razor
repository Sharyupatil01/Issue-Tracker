@page "/issues/create"
@rendermode InteractiveServer

@using IssueTracker.Web.Models
@using IssueTracker.Web.Services

@inject IssueService IssueService
@inject NavigationManager Navigation

<PageTitle>Create Issue</PageTitle>

<h1>Create Issue</h1>

<div class="mt-4">

    <EditForm Model="@newIssue" OnValidSubmit="@HandleCreateIssue">

        <div class="mb-3">
            <label class="form-label">Title</label>

            <InputText class="form-control"
                       @bind-Value="newIssue.Title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>

            <InputTextArea class="form-control"
                           @bind-Value="newIssue.Description" />
        </div>

        <div class="mb-3">
            <label class="form-label">Priority</label>

            <InputSelect class="form-select"
                         @bind-Value="newIssue.Priority">

                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
                <option value="Critical">Critical</option>

            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Status</label>

            <InputSelect class="form-select"
                         @bind-Value="newIssue.Status">

                <option value="Open">Open</option>
                <option value="In Progress">In Progress</option>
                <option value="Closed">Closed</option>

            </InputSelect>
        </div>

        <!-- Assigned User -->

        <div class="mb-3">
            <label class="form-label">Assigned To</label>

            <InputSelect class="form-select"
                         @bind-Value="newIssue.AssignedToUserId">

                <option value="">Unassigned</option>

                @foreach (var user in users)
                {
                    <option value="@user.Id">
                        @user.Name (@user.Role)
                    </option>
                }

            </InputSelect>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Create Issue
        </button>

    </EditForm>

</div>

@code {

    private Issue newIssue = new()
    {
        Status = "Open",
        Priority = "Medium"
    };

    private List<User> users = new();

    protected override async Task OnInitializedAsync()
    {
        users = await IssueService.GetUsersAsync();
    }

    private async Task HandleCreateIssue()
    {
        var createdIssue =
            await IssueService.CreateIssueAsync(newIssue);

        if (createdIssue != null)
        {
            Navigation.NavigateTo("/issues");
        }
    }
}