@page "/"
@rendermode InteractiveServer

@using IssueTracker.Web.Models
@using IssueTracker.Web.Services

@inject IssueService IssueService

<PageTitle>Dashboard</PageTitle>

<h1>Issue Tracker</h1>

<p>Welcome to the Issue Tracker.</p>

@if (stats == null)
{
    <p>Loading dashboard...</p>
}
else
{
    <div class="row mt-4">

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Total Issues</h5>
                <h2>@stats.TotalIssues</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Open</h5>
                <h2>@stats.OpenIssues</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>In Progress</h5>
                <h2>@stats.InProgressIssues</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Closed</h5>
                <h2>@stats.ClosedIssues</h2>
            </div>
        </div>

    </div>
}

@code
{
    private DashboardStats? stats;

    protected override async Task OnInitializedAsync()
    {
        stats = await IssueService.GetDashboardStatsAsync();
    }
}