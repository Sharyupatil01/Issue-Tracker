@page "/issues/{id:int}"
@rendermode InteractiveServer

@using IssueTracker.Web.Models
@using IssueTracker.Web.Services

@inject IssueService IssueService
@inject NavigationManager Navigation

<PageTitle>Issue Details</PageTitle>

<h1>Issue Details</h1>

@if (issue == null)
{
    <p>Loading issue...</p>
}
else
{
    <div class="card mt-4">
        <div class="card-body">

            <h3 class="card-title">
                @issue.Title
            </h3>

            <p class="card-text">
                @issue.Description
            </p>

            <hr />

            <p>
                <strong>Status:</strong>
                @issue.Status
            </p>

            <p>
                <strong>Priority:</strong>
                @issue.Priority
            </p>

            <p>
                <strong>Assigned To:</strong>
                @issue.AssignedTo
            </p>

            <p>
                <strong>Issue ID:</strong>
                @issue.Id
            </p>

            <button class="btn btn-secondary"
                    @onclick="GoBack">
                Back to Issues
            </button>

        </div>
    </div>
}

@code {

    [Parameter]
    public int id { get; set; }

    private Issue? issue;

    protected override async Task OnInitializedAsync()
    {
        issue = await IssueService.GetIssueAsync(id);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/issues");
    }
}