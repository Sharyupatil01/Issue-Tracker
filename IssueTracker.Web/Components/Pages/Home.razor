@page "/"

<PageTitle>Dashboard</PageTitle>

<h1>Issue Tracker</h1>

<p>Welcome to the Issue Tracker.</p>

<div class="row mt-4">

    <div class="col-md-3">
        <div class="card p-3">
            <h5>Total Issues</h5>
            <h2>0</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <h5>Open</h5>
            <h2>0</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <h5>In Progress</h5>
            <h2>0</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <h5>Closed</h5>
            <h2>0</h2>
        </div>
    </div>

</div>