@page "/issues/create"
@rendermode InteractiveServer

@using IssueTracker.Web.Models
@using IssueTracker.Web.Services

@inject IssueService IssueService
@inject NavigationManager Navigation

<PageTitle>Create Issue</PageTitle>

<h1>Create Issue</h1>

<div class="mt-4">

    <EditForm Model="@newIssue" OnSubmit="@HandleCreateIssue">

        <div class="mb-3">
            <label class="form-label">Title</label>

            <InputText class="form-control"
                       @bind-Value="newIssue.Title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>

            <InputTextArea class="form-control"
                           @bind-Value="newIssue.Description" />
        </div>

        <div class="mb-3">
            <label class="form-label">Priority</label>

            <InputSelect class="form-select"
                         @bind-Value="newIssue.Priority">

                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
                <option value="Critical">Critical</option>

            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Status</label>

            <InputSelect class="form-select"
                         @bind-Value="newIssue.Status">

                <option value="Open">Open</option>
                <option value="In Progress">In Progress</option>
                <option value="Closed">Closed</option>

            </InputSelect>
        </div>

        <button type="submit" class="btn btn-primary">
            Create Issue
        </button>


@if (!string.IsNullOrEmpty(messageError))
{
    <p class="mt-3">@messageError</p>
}
}




    </EditForm>

</div>



@code {
    private string messageError="";

    private Issue newIssue = new()
    {
        Status = "Open",
        Priority = "Medium"
    };

    private async Task HandleCreateIssue()
{
    messageError = "Button clicked...";

    var createdIssue = await IssueService.CreateIssueAsync(newIssue);

    if (createdIssue != null)
    {
        messageError = "Issue created successfully!";

        Navigation.NavigateTo("/issues");
    }
    else
    {
        messageError = "API failed to create the issue.";
    }
}

    @* private async Task HandleCreateIssue()
    {
        var createdIssue = await IssueService.CreateIssueAsync(newIssue);

        if (createdIssue != null)
        {
            Navigation.NavigateTo("/issues");
        }
    } *@

}